# Use a long, random, URL-safe value for this password. It is also part of DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-secret

# Configure an OIDC issuer that signs access tokens for this resource audience.
OIDC_ISSUER_URL=https://identity.example.test
OIDC_AUDIENCE=ubuntu-fleet-manager

# Host path mounted into the control-plane container as an application secret.
# Create a private file containing exactly 32 random bytes before starting Compose.
FILE_ACTION_KEY_SOURCE=./secrets/file-action-key
# Match this UID:GID to the owner of FILE_ACTION_KEY_SOURCE. The image defaults to 10001:10001.
CONTROL_PLANE_USER=10001:10001

# Reversible file tools are omitted unless this explicit policy is enabled.
ALLOW_FILE_WRITES=false

# Typed APT tools are omitted unless host policy and root helper policy are configured.
ALLOW_APT_WRITES=false

# Generic command execution is omitted unless each host has a reviewed exact argv policy.
ALLOW_COMMAND_EXECUTION=false

# Keep the default local-only bind for development. Use the public HTTPS URL when
# a TLS reverse proxy exposes the service to remote MCP clients.
PUBLIC_URL=http://localhost:8080
MCP_HOST_PORT=8080
LISTEN_ADDR=:8080
